    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
